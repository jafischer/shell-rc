# Skuba aliases
alias sk='skuba kubectl'
alias skh='skuba helm'
alias po='sk get pods'
alias sksh='skuba shell $(po | tail -n 1 | awk1)'
alias skbashpod='sk run --rm=true -it test-bash-$(timestamp.sh) --restart=Never --image=761590636927.dkr.ecr.us-west-2.amazonaws.com/raptor/amazonlinux2:20190129T000000Z'
alias skdelstalereplicas='sk delete replicaset `sk get replicaset | g " 0  *0  *0" | awk1`'
alias clus='skuba cluster'
alias ns='skuba namespace'

# Docker aliases
alias dc='docker-compose --project-name=$(basename $(git remote get-url origin) .git) -f docker-compose.yml $([[ -f docker-compose.override.yml ]] && echo -f docker-compose.override.yml)'
alias dcls='docker container ls'
alias dils='docker image ls'
alias dcstopall='docker container stop `dcls | tail -n +2 | awk1`'
alias dcp='docker cp'
alias dcprune='docker container prune --force'

alias gw='./gradlew'

alias cat=bat

# SSH to my 3D Printer's Raspberry Pi:
alias sshpi='ssh -i ~/.ssh/jafischer.pem pi@fluidpi.local'

alias utctime='date -u'

# Stuff the incredibly annoying "--add-opens" options into the clipboard
alias add-opens='echo -n "-ea --add-opens java.base/jdk.internal.loader=ALL-UNNAMED --add-opens java.base/java.util.concurrent=ALL-UNNAMED --add-opens java.management/java.lang.management=ALL-UNNAMED --add-opens java.base/java.time=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED" | pbcopy'
