#!/bin/bash
# Note: the hash-bang above was only added so that my IDE knows this is a bash script. But this script must be
# sourced, not executed from the command line.

# I've installed GNU date as "gdate" on the Mac and use it in the prompt. On WSL, "date" is already GNU date.
command -v gdate >& /dev/null || alias gdate=date

## Edit and then re-source .bashrc:
#alias virc='\vi ~/.bashrc; . ~/.bashrc; backup_bash_files'
## Edit and then re-source the aliases:
#alias vialiases='\vi ~/.aliases; . ~/.aliases; backup_bash_files'
#alias via='vialiases' # short form
## Edit and then re-source the functions:
#alias vifunctions='\vi ~/.functions; . ~/.functions; backup_bash_files'
#alias vifu='vifunctions' # short form
alias resource='source ~/.bash_profile'

# Use my "mycd" function instead of the cd command:
alias cd='mycd'
# Ditto for vi
alias vi='myvi'

# ls aliases
#alias l='ls -G -l'
#alias ldirs='ls -lG | grep "^d"'
#alias la='ls -G -Al'          # show hidden files
#alias lx='ls -G -lXB'         # sort by extension
