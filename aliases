#!/bin/bash
# Note: the hash-bang above was only added so that my IDE knows this is a bash script. But this script must be
# sourced, not executed from the command line.

# Command to reload everything here file after I make changes.
# shellcheck disable=SC2139
alias reload="source $STARTUP_DIR/main"

# Use my "mycd" function instead of the cd command:
alias cd='mycd'
# Ditto for vi
alias vi='myvi'

alias cdicloud='pushd "${ICLOUD_DIR}"'

# Dang circular dependencies... I'll just define is_installed here as well, since
# we need to source "aliases" before "functions".
# Determine if a command is installed
is_installed() {
  command -v $1 >&/dev/null
}

# ls aliases
# I've installed "eza", a "modern replacement for ls" (https://github.com/eza-community/eza)
if is_installed eza; then
  alias l='eza -l -s name'
  alias la='eza -la -s name'       # show hidden files
  alias lx='eza -l -s ext'         # sort by extension
  alias lt='eza -l -s date'        # sort by date, most recent last
  alias lz='eza -l -s size'        # sort by size, largest last.
  alias ldirs='eza -lD -s name'
  alias nodirs='eza -l --only-files -s name'
else
  alias l='ls -G -l'
  alias la='ls -G -Al'          # show hidden files
  alias lx='ls -G -lXB'         # sort by extension
  alias lt='ls -G -ltr'         # sort by date, most recent last
  alias lz='ls -G -lSr'         # sort by size, largest last.
  alias ldirs='ls -lG | grep "^d"'
  alias nodirs='l | gv "^[ld]" | gv "^total"'
fi

# I've also installed "bat", an enhanced "cat" and "less" combined.
is_installed bat && alias cat=bat

###
### Misc aliases
###
# Shortcut for grep ("-s" means suppress error messages about directories and such)
alias g='grep -s'
# grep -i == ignore case
alias gi='grep -si'
# grep -l == show line numbers
alias gl='grep -sl'
# grep -il == grep -i and grep -l combined
alias gil='grep -sil'
# grep -v == show everything BUT the matching lines
alias gv='grep -sv'
# In DOS/Windows, the mkdir command is "md", and when I'm switching back and forth I get confused...
# Also I add the "-p" option to let you make multiple directory levels in one command:
# $ md three/levels/deep
# Instead of:
# $ md three
# $ md three/levels
# $ md three/levels/deep
alias md='mkdir -p'
alias rd='rmdir'
# Make 'less' do case-insensitive searches
alias less='\less --quit-if-one-screen --ignore-case'
# Show my $PATH, but one directory per line
alias path='echo -e ${PATH//:/\\n}'
alias pd=mypd
alias pp=popd
# Echo without a newline
alias echo_no_newline='printf'
# For short:
alias en=echo_no_newline
# Convenient short form of the find command. Just "fnd SomeFilePattern".
alias fnd='find . -name '
# Show all processes owned by me
alias pu='ps -fU $UID'
# Shutdown now
alias s0="sudo shutdown -h now"
# Shutdown and restart
alias sr0="sudo shutdown -r now"
# Show disk usage of the directories under the current directory.
# But note: I don't use this since installing ncdu (brew install ncdu). It's much nicer.
alias du="\du -d 0 -m"
# Directory usage for everything in the current dir, sorted.
alias dus="du * | sort -n"
# Quick ping (otherwise ping runs forever)
alias p="ping -c 1"
# Kill it dead
alias k9='kill -9'
# List zip contents (verbosely)
alias uv='unzip -v'
# Print a number in hex
alias hex='printf "0x%08x\n"'
# Print a hex number in decimal (must use 0x prefix)
alias dec='printf "%d\n"'
# Stop shouting at me, uuidgen!
# Convert uppercase uuid to lowercase. Also, strip the trailing newline so I can more
# easily paste into code. (e.g. "uuidgen | pbcopy")
alias uuidgen='echo_no_newline $(\uuidgen | tr "[:upper:]" "[:lower:]")'
# Reverse the lines of a file.
alias reverse='tail -r'
# Curl with newline added to the end of the output
alias curlnl='curl -w "\n"'
# Show current UTC time
alias utctime='date -u'
# Shorter way of running the ubiquitous gradle build script.
alias gw='./gradlew'

###
### Convenient shortcuts for selecting the nth word of output.
###
alias awk1="awk '{print \$1}'"
alias awk2="awk '{print \$2}'"
alias awk3="awk '{print \$3}'"
alias awk4="awk '{print \$4}'"
alias awk5="awk '{print \$5}'"
alias awk6="awk '{print \$6}'"
alias awk7="awk '{print \$7}'"
alias awk8="awk '{print \$8}'"
alias awk9="awk '{print \$9}'"
alias awklast="awk '{print \$NF}'"

###
### Git aliases
###
alias gst='git status'
alias gcm='git commit'
alias gpush='git push origin'
alias gpull='git fetch --prune; git pull'
alias gchmod='git update-index --chmod=+x'
# See https://github.sie.sony.com/SIE/safety-scripts/blob/main/git-url.sh
is_installed git-url.sh && alias gurl='git-url.sh'
# Switch to main branch and pull
alias gmain='git checkout main; gpull'

###
### sk8s aliases (see https://github.sie.sony.com/jafischer/sk8s)
###
alias 8l='sk8s login'
alias 8h='sk8s health'
alias 8pf='sk8s port-forward'
alias 8rp='sk8s restart-pods'
alias 8wp='sk8s watch-pods'
alias 8dv='sk8s deploy-version'
# This one's just for me while testing things:
# run sk8s from my git repo instead of the one in my path.
alias s='~/mysrc/sk8s/target/debug/sk8s'

###
### Skuba aliases
###
alias sk='skuba kubectl'
alias skh='skuba helm'
alias po='sk get pods'
alias clus='skuba cluster'
alias ns='skuba namespace'

###
### Docker aliases
###
alias dcls='docker container ls'
alias dils='docker image ls'
alias dcstopall='docker container stop `dcls | tail -n +2 | awk1`'

# SSH to my 3D Printer's Raspberry Pi:
alias sshpi='ssh -i ~/.ssh/jafischer.pem pi@fluidpi.local'

# Friendly wrappers for od
alias od-char='od -c'
alias od-hex='od -t x1'
alias od-hexword='od -x'

if is_wsl; then
  # GNU date is the default on Linux.
  alias gdate=date
  # For some reason running the windows git.exe is significantly faster than running the linux git binary.
  alias git=git.exe
fi

# Rust-specific aliases
alias cfmt='cargo +nightly fmt --all'
alias cversion="cargo metadata --format-version 1 --no-deps | jq .packages[0].version | sed -e 's/\"//g'"
alias ctest='cargo test --workspace --all'