# Some functions to determine what system we're running on (I use the same bash scripts on Windows/WSL and
# the Mac.
# They're not in the "functions" file because they are used in "aliases", but "aliases" must be sourced
# before "functions" (since some functions use the aliases)...

is_mac() {
  [[ $(uname) == "Darwin" ]]
}

is_linux() {
  [[ $(uname) == "Linux" ]]
}

is_wsl() {
  is_linux && [[ -d /mnt/c ]]
}

my_os() {
  if is_mac; then
    echo mac
  elif is_wsl; then
    echo wsl
  elif is_linux; then
    echo linux
  else
    echo unknown-os
  fi
}

# Rather than using $SHELL to determine zsh vs bash, examine the current process. That way, starting a zsh subshell
# when running bash, or a bash subshell when running zsh, will still work.
current_shell() {
  local shell
  # "ps -p" output is PID TTY TIME CMDLINE
  shell=$(ps -p $$ | tail -n 1 | awk '{print $4}')

  # Interactive shell for some reason shows up as "-bash":
  # 74076 ttys000    0:00.10 -bash
  # So strip off any leading '-'
  echo "${shell/#-/}"
}

is_bash() {
  [[ $(current_shell) == *bash ]]
}

is_zsh() {
  [[ $(current_shell) == *zsh ]]
}
