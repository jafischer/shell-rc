#!/bin/bash
# Note: the hash-bang above was only added so that my IDE knows this is a bash script. But this script must be
# sourced, not executed from the command line.

is_absolute_path() {
  local path="$1"
  [[ "${path:0:1}" == "/" ]] || [[ "${path:0:1}" == "~" ]]
}

# Find a directory using various heuristics
choosedir() {
  local dir="$1" expanded_dir

  # If no arg given then just echo "" (cd with no args will go to $HOME).
  [[ -z "$dir" ]] && { echo "$HOME"; return 0; }

  # Similarly, "cd -" means "cd to previous location".
  [[ "$dir" == "-" ]] && { echo "-"; return 0; }

  # If the specified directory exists, just echo it, and we're done.
  is_absolute_path "$1" && [[ -d "$dir" ]] && { echo "$dir"; return 0; }
  ! is_absolute_path "$1" && [[ -d "./$dir" ]] && { echo "./$dir"; return 0; }

  # Check list of shortcuts for some frequent destinations:
  case $dir in
    en)         echo "$MY_SRC_DIR/kamaji-eliot-ness"; return 0 ;;
    ga)         echo "$MY_SRC_DIR/kamaji-garbo"; return 0 ;;
    gc)         echo "$MY_SRC_DIR/garbo-cpp"; return 0 ;;
    cap)        echo "$MY_SRC_DIR/capone"; return 0 ;;
    crc)        echo "$MY_SRC_DIR/capone-report-collector"; return 0 ;;
    crp)        echo "$MY_SRC_DIR/capone-report-processor"; return 0 ;;
    ccs)        echo "$MY_SRC_DIR/capone-content-store"; return 0 ;;
    cc)         echo "$MY_SRC_DIR/capone-cron"; return 0 ;;
    sp)         echo "$MY_SRC_DIR/speakeasy2"; return 0 ;;
    sc)         echo "$MY_SRC_DIR/safety-commons"; return 0 ;;
    ss)         echo "$MY_SRC_DIR/safety-scripts"; return 0 ;;
    lf)         echo "$MY_SRC_DIR/lego-framework"; return 0 ;;
    3)          echo "$MY_SRC_DIR/../3rdparty"; return 0 ;;
    p)          echo "$MY_SRC_DIR/pickford"; return 0 ;;
    pf)         echo "$MY_SRC_DIR/pathfinder"; return 0 ;;
    prof)       echo "$MY_SRC_DIR/pathfinder/sdk/target/samples/sample_code/playstation_network/api_webapi_profanity"; return 0 ;;
    dl)         echo ~/Downloads; return 0 ;;
    v)          echo ~/Library/Mobile\ Documents/com~apple~CloudDocs/voroncfg; return 0 ;;
    m)          echo "$MY_SRC_DIR/meccano"; return 0 ;;
    gb)         echo "$MY_SRC_DIR/gatsby"; return 0 ;;
  esac

  # Search for the directory in $CDPATH.
  for path_dir in ${CDPATH//:/ }; do
    # The added "eval" is there to expand ~ into the home dir.
    path_dir="$(eval echo ${path_dir})"
    expanded_dir="$(eval echo ${path_dir}/$dir)"

    if [[ -d $expanded_dir ]]; then
      echo "$expanded_dir"
      return 0
    fi

    # New feature: intelligently figure out shortcuts. E.g. "ken" will match with kamaji-eliot-ness.
    # Convert $dir to a regex. E.g. "ken" --> "^\./k[^-]*-e[^-]*-n[^-]*$"
    local regex=$(echo $dir | sed -e 's/\(.\)/\1[^-]*-/g; s/-$/\$/; s/^/\^\\.\//1')
    
    # Use find to list files in the current directory that are directories.
    pushd $path_dir >&/dev/null || { echo "Invalid dir in CDPATH: '$path_dir'"; return 1; }
    local local_dir local_dirs=$(find . -maxdepth 1 -type d ! -name .)

    for local_dir in $local_dirs; do
      echo "$local_dir" | grep "$regex" >& /dev/null
      # shellcheck disable=SC2181
      if [[ $? == 0 ]]; then
        expanded_dir="$(eval echo ${path_dir}/$local_dir)"
        echo "$expanded_dir"
        # shellcheck disable=SC2164
        popd >& /dev/null
        return 0
      fi
    done
    # shellcheck disable=SC2164
    popd >& /dev/null
  done

  # Not found, so just echo the argument
  echo $dir
}

mycd() {
  # shellcheck disable=SC2164
  \cd "$(choosedir "$1")"
}

launch_ide() {
  local ide="$1" dir="$2"

  ( $ide "$(choosedir "$dir")" >&/dev/null & sleep 7; layout )
}

# ij for IntelliJ
