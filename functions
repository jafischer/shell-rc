#!/bin/bash
# Note: the hash-bang above was only added so that my IDE knows this is a bash script. But this script must be
# sourced, not executed from the command line.

# Determine if a path is absolute or relative
is_absolute_path() {
  local path="$1"
  [[ "${path:0:1}" == "/" ]] || [[ "${path:0:1}" == "~" ]]
}

# Determine if a command is installed
is_installed() {
  command -v $1 >&/dev/null
}

# Might seem silly, but it's amazing how much easier it is to type "up" than "cd .."
# And as an added bonus, you can supply an argument to jump up several directories at once.
up() {
  local count=$1 i
  [[ -z $count ]] && count=1
  for i in $(seq 1 $count); do
    \cd .. || return 1
  done
}

# Find a directory using various heuristics. This is used by "mycd" and the various IDE-launching functions below.
# Example:
# $ choosedir crc
# /Users/jafischer/src/capone-report-collector
#
# Here are the methods used to find a match (if a directory with the exact name isn't found)
#
# 1. A list of personalized shortcuts, e.g. "en" for my "kamaji-eliot-ness" repo.
# 2. Since most of our git repos consist of multiple words seperated by hyphens, do a fuzzy search in $CDPATH
#    using each letter as the start of a word. In other words, "crc" will match "capone-report-collector",
#    "ken" will match "kamaji-eliot-ness", and so on.
choosedir() {
  local dir="$1" path_dir expanded_dir regex local_dir local_dirs

  # If no arg given then just echo "" (cd with no args will go to $HOME).
  [[ -z "$dir" ]] && { echo "$HOME"; return 0; }

  # Similarly, "cd -" means "cd to previous location".
  [[ "$dir" == "-" ]] && { echo "-"; return 0; }

  # If the specified directory exists, just echo it, and we're done.
  is_absolute_path "$1" && [[ -d "$dir" ]] && { echo "$dir"; return 0; }
  ! is_absolute_path "$1" && [[ -d "./$dir" ]] && { echo "./$dir"; return 0; }

  # Check list of shortcuts for some frequent destinations:
  ### PERSONALIZE THIS
  case $dir in
    en)   echo "$SRC_DIR/kamaji-eliot-ness"; return 0 ;;
    ga)   echo "$SRC_DIR/kamaji-garbo"; return 0 ;;
    gc)   echo "$SRC_DIR/garbo-cpp"; return 0 ;;
    sp)   echo "$SRC_DIR/speakeasy2"; return 0 ;;
    sc)   echo "$SRC_DIR/safety-commons"; return 0 ;;
    ss)   echo "$SRC_DIR/safety-scripts"; return 0 ;;
    lf)   echo "$SRC_DIR/lego-framework"; return 0 ;;
    3)    echo "$SRC_DIR/../3rdparty"; return 0 ;;
    my)   echo "$SRC_DIR/../mysrc"; return 0 ;;
    p)    echo "$SRC_DIR/pickford"; return 0 ;;
    pf)   echo "$SRC_DIR/pathfinder"; return 0 ;;
    prof) echo "$SRC_DIR/pathfinder/sdk/target/samples/sample_code/playstation_network/api_webapi_profanity"; return 0 ;;
    dl)   echo ~/Downloads; return 0 ;;
    v)    echo "$ICLOUD_DIR/voroncfg"; return 0 ;;
    m)    echo "$SRC_DIR/meccano"; return 0 ;;
    gb)   echo "$SRC_DIR/gatsby"; return 0 ;;
    pa)   echo "$SRC_DIR/presidio-analyzer"; return 0 ;;
    pa2)  echo "$SRC_DIR/presidio-anonymizer"; return 0 ;;
  esac

  # Search for the directory in $CDPATH. (Note: we don't actually have to do this, since the cd
  # command will automatically use CDPATH, but we're searching CDPATH anyway for the fuzzy match; and also we
  # use this for the launch_ide function as well).
  for path_dir in ${CDPATH//:/ }; do
    # The added "eval" is there to expand ~ into the home dir.
    path_dir="$(eval echo ${path_dir})"
    expanded_dir="$(eval echo ${path_dir}/$dir)"

    if [[ -d $expanded_dir ]]; then
      log_debug "Using exact match of path_dir/dir (${path_dir}/$dir) from CDPATH"
      echo "$expanded_dir"
      return 0
    fi

    # Fuzzy search: e.g. "ken" will match with kamaji-eliot-ness.
    # So we want to convert the letters in "$dir" to a regular expression
    # that will find hyphenated words starting with each letter.
    # E.g. "ken" --> "k[^-]*-e[^-]*-n[^-]*$"
    # shellcheck disable=SC2001
    regex=$(echo $dir | sed -e 's/\(.\)/\1[^-]*-/g')
    log_debug "First substitution: $regex"
    # shellcheck disable=SC2001
    regex=$(echo $regex | sed -e 's/-$/\$/')
    log_debug "2nd: $regex"

    # Use find to list files in the current directory that are directories.
    pushd $path_dir >&/dev/null || { log "${RED}Invalid dir in CDPATH: '$path_dir'"; return 1; }
    local_dirs=$(find . -maxdepth 1 -type d ! -name .)

    for local_dir in $local_dirs; do
      echo "$local_dir" | grep "^[.]/$regex" >& /dev/null
      # shellcheck disable=SC2181
      if [[ $? == 0 ]]; then
        # Remove the "./" prefix
        local_dir="${local_dir/.\//}"
        expanded_dir="$(eval echo ${path_dir}/$local_dir)"
        log_debug "Using regex match of path_dir/dir (path_dir=${path_dir}, local_dir=$local_dir) from CDPATH"
        echo "$expanded_dir"
        # shellcheck disable=SC2164
        popd >& /dev/null
        return 0
      fi
    done
    # shellcheck disable=SC2164
    popd >& /dev/null
  done

  log_debug "No match found for $dir"
  # Not found, so just echo the argument
  echo $dir
}

mycd() {
  # shellcheck disable=SC2164
  if \cd "$(choosedir "$1")"; then
    if [[ -d ./.git ]] && ! [[ -e ./.git/hooks/pre-commit ]] && [[ -d "$SRC_DIR/safety-scripts" ]]; then
      log "Copying git hooks from $SRC_DIR/safety-scripts/git-hooks"
      cp "$SRC_DIR/safety-scripts"/git-hooks/* .git/hooks
    fi
  fi
}

# Functions for launching an IDE on a project directory, using the same logic as
# my cd command (e.g. "ij en" to launch IntelliJ on my kamaji-eliot-ness repo).
launch_ide() {
  local ide="$1" dir="$2"

  dir="$(choosedir "$dir")"
  if ! [[ -d "$dir" ]]; then
    echo "$dir not found"
    return 1
  fi
  is_wsl && dir="$(windows_path "$dir")"
  ($ide "$dir" >&/dev/null &)
}
# ij for IntelliJ
ij() { launch_ide idea "$1"; }
# cl for CLion
cl() { launch_ide clion "$1"; }
# rr for RustRover
rr() { launch_ide rustrover "$1"; }
# ws for WebStorm
ws() { launch_ide webstorm "$1"; }
# "py" for PyCharm
py() { launch_ide pycharm "$1"; }
# "gl" is already an alias, so gogo for GoLand
gogo() { launch_ide goland "$1"; }

myvi() {
  # If running on a Mac, just run mvim (MacVim) with the supplied arguments.
  is_mac && {
    # is MacVim installed?
    if is_installed mvim; then
      mvim "$@"
    elif is_installed vim; then
      vim "$@"
    else
      \vi "$@"
    fi
    return
  }

  is_wsl && {
    # On Windows/WSL, it's a tad more complicated...
    local fixedargs

    # Since gvim.exe is a Windows exe, need to convert any linux paths to \\wsl$\Ubuntu-18.04\...
    for arg in "$@"; do
      if [[ -n $(readlink "$arg") ]]; then
        arg=$(readlink "$arg")
      fi
      arg=$(windows_path "$arg")

      fixedargs="$fixedargs $arg"
    done

    ( gvim.exe $fixedargs >&/dev/null & )
    return
  }

  \vi "$@"
}

# Yes/no prompt
ask() {
  echo -n "$@" '[y/n] ' ; read ans
  case "$ans" in
    y*|Y*) return 0 ;;
    *) return 1 ;;
  esac
}

# Extract just the ipv4 addresses from ifconfig output
ip() {
  echo
  ifconfig | grep "inet" | awk2 | grep -v ':'
  echo
}

# Extract just the ipv6 addresses from ifconfig output
ip6() {
  echo
  ifconfig | grep "inet" | awk2 | grep ':'
  echo
}

log() {
  echo -e "$(date +%T)" "$CYAN$*$NC" 2>&1
}

log_debug() {
  # shellcheck disable=SC2154
  [[ -n "$DEBUG" ]] &&
    echo -e "$(date +%T)" "$cyan$*$NC" 2>&1
}

# Since 'in' is a keyword, using 'inn'.
# This function performs a command in the specified directory(ies).
#
# Examples:
# inn ./abc touch somefile
# inn ./\* doSomething \> something.out
#
inn() {
  local dirs=$1
  shift

  for dir in $dirs; do
    local result=0
    pushd $dir >/dev/null || { echo -e $RED$dir is not a directory$NC; continue; }

    echo -e "\x1b[1;44;33mDir: $dir\tCmd: " "$@" "$NC"

    # shellcheck disable=SC2294
    eval "$@" || {
      result=$?
      echo -e "${RED}Command failed in $dir$NC"
    }

    # shellcheck disable=SC2164
    popd >/dev/null

    if [[ $result != 0 ]]; then
      return $result
    fi
  done
}

# I hate how the 'expr' command doesn't do floating point. 
fexpr() {
  python3 -c "import math; print($*)"
}

# Search libraries in the current directory for a symbol
findlib() {
  for f in *.a; do
    nm $f | grep "$*" && echo $f
  done
}

# Because I save a huge history, I don't want to show it all by default (otherwise it fills my terminal screen buffer).
# So this shows 50 lines by default, or the number specified as an argument.
h() {
  count=$1
  if [[ -z "$1" ]]; then
    count=50
  else
    shift
  fi

  history $count "$@"
}

# Search your history
hgrep() {
  history | grep "$@" | grep -v hgrep
}

# Convert UTC time to local.
utc-to-local() {
  # Input format must be 2021-02-19T15:10:28Z
  #local t=${1:0:4}-${1:4:2}-${1:6:5}:${1:11:2}:${1:13:2}
  local t=${1/T/ }
  date +"%F %T" -d "${t} +0"
}

# Run "sk8s logs" and then launch vim on the log directory.
slog() {
  sk8s logs "$@"
  [[ -d sk8s-logs ]] && vi sk8s-logs
}

# Switch between JDK versions
jdk() {
  [[ -z $1 ]] && { 
    echo "Usage: jdk VERSION"
    exit 1
  }

  sudo rm /Library/Java/JavaVirtualMachines/current
  [[ -e /Library/Java/JavaVirtualMachines/amazon-corretto-$1.jdk ]] || {
    echo "/Library/Java/JavaVirtualMachines/amazon-corretto-$1.jdk not found."
    exit 1
  }

  sudo ln -s amazon-corretto-$1.jdk /Library/Java/JavaVirtualMachines/current
}

if is_mac; then
  #
  # Mac-specific functions
  #

  meld() {
    ( /Users/jafischer/Applications/Meld.app/Contents/MacOS/Meld "$@" >&/dev/null & )
  }

  # Launch DiffMerge
  dm() {
    ( /Applications/DiffMerge.app/Contents/MacOS/DiffMerge "$@" >&/dev/null & )
  }

elif is_wsl; then
  #
  # WSL-specific functions
  #

  meld()
  {
    Meld.exe "$@" &
  }

  # Convert a path to linux format.
  linux_path()
  {
    local p="$1"

    is_linux || echo "ERROR: linux_path called on $(uname)"
 
    # Convert Windows drive letter to /mnt path.
    p=${p/C:/\/mnt\/c}
    p=${p/D:/\/mnt\/c}
    p=${p/E:/\/mnt\/c}
    p=${p/F:/\/mnt\/c}
  
    # Replace backslashes with forward slashes.
    p=${p//\\/\/}
  
    echo "$p"
  }

  # Convert a path to Windows format (i.e. so it can be passed to a Windows executable).
  function windows_path()
  {
    local p="$1"

    is_wsl || echo "ERROR: windows_path called on $(uname)"
 
    # Change /mnt/c/ to /
    if [[ "$p" == "/mnt/"* ]]; then
      p=${p/\/mnt\/?/}
    else
      # In case ~ is not expanded:
      # shellcheck disable=SC2088
      if [[ "$p" == "~/"* ]]; then
        p="$HOME${p/~/}"
      fi

      # Relative paths work as-is, because the windows process starts up with the Linux current directory.
      # Is this an absolute path?
      if [[ "$p" == "/"* ]]; then
        local ubuntu_version=$(lsb_release -a | grep Release: | awk2)
        p="//wsl\$/Ubuntu-$ubuntu_version$p"
      fi
    fi

    echo $p
  }
fi

# URL-encode the arguments
urlencode() {
  echo -n "$@"| jq -sRr '@uri'
}

# Sound a bell (useful when running a long command and you want to know when it's finished).
bell() {
  local count=$1
  [[ -z $count ]] && count=1

  local i
  for i in $(seq 1 $count); do
    echo -en '\a'
  done
}

# Sort the input by line length (longest last).
sort-by-line-length() {
  awk '{ print length, $0 }' | sort -n -s | cut -d" " -f2-
}

# "xa", short for "xaws Aloy", but the with added benefit of highlighting the
# desired role in the bewilderingly long list of role choices.
#
# Example:
# xa dev16
xa() {
  local role=$1

  if [[ -z $role ]]; then
    xaws Aloy
  else
    # Learn something new every day. The "2> >(...)" syntax redirects ONLY
    # stderr to the process within the parentheses.
    xaws Aloy 2> >(
      # This funky perl line is just to get the desired role highlighted.
      # And we're using Perl rather than sed because OSX sed doesn't support \x, but perl does!
      perl -p -e "s/Account:/\x1b\[0mAccount:/; s/(Account: .*$role)/\x1b\[1;32m\$1/; s/Selections/\x1b\[0mSelections/"
    )
  fi
}

# Creates a new script in ~/bin and chmod's it
newscript() {
  local name="$HOME/bin/$1"
  echo -e "#!/bin/bash\n" > "$name"
  chmod +x "$name"
  # + option means go to last line
  vi + "$name"
}
