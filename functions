#
# Functions: when you need something a bit more complex than an alias (e.g. you want to process parameters).
#

# Determine if a path is absolute or relative
is_absolute_path() {
  local p="$1"
  [[ "${p:0:1}" == "/" ]] || [[ "${p:0:1}" == "~" ]]
}

# Determine if a command is installed
is_installed() {
  command -v "$1" >&/dev/null
}

# Might seem silly, but it's amazing how much easier it is to type "up" than "cd .."
# And as an added bonus, you can supply a numeric argument to jump up several directories at once.
up() {
  local count=$1 i
  [[ -z $count ]] && count=1
  for i in $(seq 1 "$count"); do
    \cd .. || return 1
  done
}

# Find a directory using various heuristics. This is used by "mycd" and the various IDE-launching functions below.
# Example:
# $ choosedir bfs
# /Users/jafischer/mysrc/bevy-fluid-sim
#
# Here are the methods used to find a match (if a directory with the exact name isn't found)
#
# 1. A list of personalized shortcuts, e.g. "en" for my "kamaji-eliot-ness" repo.
# 2. Since most of our git repos consist of multiple words separated by hyphens, do a fuzzy search in $CDPATH
#    using each letter as the start of a word. In other words, "bfs" will match "bevy-fluid-sim",
#    "sr" will match "shell-rc", and so on.
choosedir() {
  local dir="$1" path_dir expanded_dir regex local_dir local_dirs

  # If no arg given then just echo "" (cd with no args will go to $HOME).
  [[ -z "$dir" ]] && { echo "$HOME"; return 0; }

  # Similarly, "cd -" means "cd to previous location".
  [[ "$dir" == "-" ]] && { printf "-"; return 0; }

  # If the specified directory exists, just echo it, and we're done.
  is_absolute_path "$1" && [[ -d "$dir" ]] && { echo "$dir"; return 0; }
  ! is_absolute_path "$1" && [[ -d "./$dir" ]] && { echo "./$dir"; return 0; }

  # Check list of shortcuts for some frequent destinations. This function is to be defined in
  # the `personalized` file.
  personalized_choosedir "$dir" && return 0

  # Search for the directory in $CDPATH. (Note: we don't actually have to do this, since the cd
  # command will automatically use CDPATH, but we're searching CDPATH anyway for the fuzzy match; and we
  # use this for the launch_ide function as well).
  for path_dir in ${CDPATH//:/ }; do
    # The added "eval" is there to expand ~ into the home dir.
    path_dir="$(eval echo "${path_dir}")"
    expanded_dir="$(eval echo "${path_dir}/$dir")"

    if [[ -d $expanded_dir ]]; then
      log_debug "Using exact match of path_dir/dir (${path_dir}/$dir) from CDPATH"
      echo "$expanded_dir"
      return 0
    fi
  done

  # Fuzzy search:
  # We want to convert the letters in "$dir" to a regular expression
  # that will find hyphenated words starting with each letter.
  for path_dir in ${CDPATH//:/ }; do
    # The added "eval" is there to expand ~ into the home dir.
    path_dir="$(eval echo "${path_dir}")"
    expanded_dir="$(eval echo "${path_dir}/$dir")"

    # shellcheck disable=SC2001
    regex=$(echo "$dir" | sed -e 's/\(.\)/\1[^-]*-/g')
    log_debug "First substitution: $regex"
    # shellcheck disable=SC2001
    regex=$(echo "$regex" | sed -e 's/-$/\$/')
    log_debug "2nd: $regex"

    # Use find to list files in the current directory that are directories.
    pushd "$path_dir" >&/dev/null || { log_error "Invalid dir in CDPATH: '$path_dir'"; return 1; }
    local_dirs=$(find . -depth 1  -maxdepth 1 -type d)

    for local_dir in $local_dirs; do
      log_debug "Does $local_dir match?"
      echo "$local_dir" | grep "^[.]/$regex" >& /dev/null
      # shellcheck disable=SC2181
      if [[ $? == 0 ]]; then
        # Remove the "./" prefix
        local_dir="${local_dir/.\//}"
        expanded_dir="$(eval echo "${path_dir}/$local_dir")"
        log_debug "Using regex match of path_dir/dir (path_dir=${path_dir}, local_dir=$local_dir) from CDPATH"
        echo "$expanded_dir"
        # shellcheck disable=SC2164
        popd >& /dev/null
        return 0
      fi
    done
    # shellcheck disable=SC2164
    popd >& /dev/null
  done

  log_debug "No match found for $dir"
  # Not found, so just echo the argument
  echo "$dir"
}

mycd() {
  local target
  target="$(choosedir "$1")" || return 1

  \cd "$target" || return 1

  # See https://github.com/jafischer/git-hooks for my git hooks.
  if [[ -d ./.git ]] && ! [[ -e ./.git/hooks/pre-commit && -e "$MYSRC_DIR/git-hooks/install-git-hooks" ]]; then
    log_error "NOTE: this repo has no git hooks. Run this:"
    # shellcheck disable=SC2088
    log_error "$MYSRC_DIR/git-hooks/install-git-hooks"
  fi
}

mypd() {
  local target
  target="$(choosedir "$1")" || return 1

  \pushd "$target" || return 1
}

# Functions for launching an IDE on a project directory, using the same logic as
# my cd command (e.g. "ij en" to launch IntelliJ on my kamaji-eliot-ness repo).
launch_ide() {
  local ide="$1" dir="$2"

  dir="$(choosedir "$dir")"
  if ! [[ -d "$dir" ]]; then
    echo "$dir not found"
    return 1
  fi
  is_wsl && dir="$(windows_path "$dir")"
  ($ide "$dir" >&/dev/null &)
}
# ij for IntelliJ
ij() { launch_ide idea "$1"; }
# cl for CLion
cl() { launch_ide clion "$1"; }
# rr for RustRover
rr() { launch_ide rustrover "$1"; }
# ws for WebStorm
ws() { launch_ide webstorm "$1"; }
# "py" for PyCharm
py() { launch_ide pycharm "$1"; }
# "gl" is already an alias, so gogo for GoLand
gogo() { launch_ide goland "$1"; }

# st: open the specified directory in SourceTree
st() {
  local dir
  dir="$(choosedir "$1")"
  if ! [[ -d "$dir" ]]; then
    echo "$dir not found"
    return 1
  fi
  open -a SourceTree "$dir"
}

myvi() {
  # If running on a Mac, just run mvim (MacVim) with the supplied arguments.
  is_mac && {
    # is MacVim installed?
    if is_installed mvim; then
      mvim "$@"
    elif is_installed vim; then
      vim "$@"
    else
      \vi "$@"
    fi
    return
  }

  is_wsl && {
    # On Windows/WSL, it's a tad more complicated...
    local fixedargs arg

    # Since gvim.exe is a Windows exe, need to convert any linux paths to \\wsl$\Ubuntu-NN.NN\...
    for arg in "$@"; do
      if [[ -n $(readlink "$arg") ]]; then
        arg=$(readlink "$arg")
      fi
      arg=$(windows_path "$arg")

      fixedargs="$fixedargs $arg"
    done

    ( gvim.exe "$fixedargs" >&/dev/null & )
    return
  }

  \vi "$@"
}

# Yes/no prompt
ask() {
  local answer
  echo_no_newline "$@" '[y/n] ' ; read -r answer
  case "$answer" in
    y*|Y*) return 0 ;;
    *) return 1 ;;
  esac
}

# Extract just the ipv4 addresses from ifconfig output
ip() {
  echo
  ifconfig | grep "inet" | awk2 | grep -v ':'
  echo
}

# Extract just the ipv6 addresses from ifconfig output
ip6() {
  echo
  ifconfig | grep "inet" | awk2 | grep ':'
  echo
}

log() {
  echo -e "$CYAN$*$NC" 1>&2
}

log_debug() {
  # shellcheck disable=SC2154
  [[ -n "$DEBUG" ]] &&
    echo -e "$cyan$*$NC" 1>&2
}

log_stdout() {
  echo -e "${CYAN}$*$NC"
}

log_heading() {
  local heading="$*" ruler
  # Strip ansi color codes out of the message when creating the ruler
  ruler=$(echo -n "$heading" | sed -e 's/\\x1b\[[0-9;]*m//g' | sed -e 's/./=/g')

  echo -e "${CYAN}+=${ruler}=+$NC" 1>&2
  echo -e "${CYAN}| $* ${CYAN}|$NC" 1>&2
  echo -e "${CYAN}+=${ruler}=+$NC" 1>&2
}

log_error() {
  echo -e "${RED}$*$NC" 1>&2
}

log_no_newline() {
  echo -en "${CYAN}$*$NC" 1>&2
}

prompt() {
  echo -en "${YELLOW}$*$NC [Y/n] " 1>&2
  local p
  read -r p
  if [[ -z ${p} ]] || [[ ${p} == y ]] || [[ ${p} == Y ]]; then
    return 0
  else
    return 1
  fi
}


# Since 'in' is a keyword, using 'inn'.
# This function performs a command in the specified directory(ies).
#
# Usage: inn DIRECTORIES COMMAND
# Note: any wildcards in the DIRECTORIES must be escaped.
#
# Examples:
# inn ./abc touch somefile
# inn ./\* doSomething \> something.out
#
inn() {
  local dirs=$1 dir
  shift

  for dir in $dirs; do
    [[ ! -d $dir ]] && continue
    local result=0
    pushd "$dir" >/dev/null || { echo -e "$RED$dir is not a directory$NC"; continue; }

    echo -e "\x1b[1;44;33mDir: $dir\tCmd: " "$@" "$NC"

    # shellcheck disable=SC2294
    eval "$@" || {
      result=$?
      echo -e "${RED}Command failed in $dir$NC"
    }

    # shellcheck disable=SC2164
    popd >/dev/null

    if [[ -z $IGNORE_FAILURE ]] && [[ $result != 0 ]]; then
      return $result
    fi
  done
}

# I hate how the 'expr' command doesn't do floating point. 
fexpr() {
  python3 -c "import math; print($*)"
}

# Search libraries in the current directory for a symbol
findlib() {
  local f
  for f in *.a; do
    nm "$f" | grep "$*" && echo "$f"
  done
}

# Because I save a huge history, I don't want to show it all by default (otherwise it fills my terminal screen buffer).
# So this shows 99 lines by default, or the number specified as an argument.
h() {
  local count=$1
  if [[ -z "$1" ]]; then
    count=99
  else
    shift
  fi

  history "$count" "$@"
}

# In zsh, the `history` command is aliased to `fc -l` and only shows the history since the shell was started, but
# I want history from $HISTFILE as well:
if is_zsh; then
  history() {
    local count=$1
    if [[ -z "$1" ]]; then
      count=$HISTSIZE
    else
      shift
    fi

    fc -i -l "-$count" "$@"
  }
fi

# Search your history
hgrep() {
  history | grep "$@" | grep -v hgrep
}

# Convert UTC time to local.
utc-to-local() {
  # Input format must be 2021-02-19T15:10:28Z
  #local t=${1:0:4}-${1:4:2}-${1:6:5}:${1:11:2}:${1:13:2}
  local t=${1/T/ }
  date +"%F %T" -d "${t} +0"
}

# Switch between JDK versions
jdk() {
  [[ -z $1 ]] && { 
    echo "Usage: jdk VERSION"
    exit 1
  }

  sudo rm /Library/Java/JavaVirtualMachines/current
  [[ -e /Library/Java/JavaVirtualMachines/amazon-corretto-$1.jdk ]] || {
    echo "/Library/Java/JavaVirtualMachines/amazon-corretto-$1.jdk not found."
    exit 1
  }

  sudo ln -s "amazon-corretto-$1.jdk" /Library/Java/JavaVirtualMachines/current
}

if is_mac; then
  #
  # Mac-specific functions
  #

  meld() {
    local meld_path script_input

    meld_path=$(which meld) || { echo "meld not found in path"; return 1; }

    # The UI app needs to be run in the background, otherwise command line can't
    # be used again until app quits.
    ( "$meld_path" "$@" >&/dev/null & )
    sleep 1
    # Meld has a nasty habit of appearing half on-screen, half off.
    # So I use my layout app to move it
    # (see https://github.com/jafischer/layout-rs)
    is_installed layout && layout restore --app Meld
    if is_installed osascript; then
      script_input=$(printf "%s\n" \
        "tell application \"Meld\"" \
        "  activate" \
        "end tell")
      osascript <<< "$script_input"
    fi
  }

elif is_wsl; then
  #
  # WSL-specific functions
  #

  meld()
  {
    Meld.exe "$@" &
  }

  # Convert a path to linux format.
  linux_path()
  {
    local p="$1"

    is_linux || echo "ERROR: linux_path called on $(uname)"
 
    # Convert Windows drive letter to /mnt path.
    p=${p/C:/\/mnt\/c}
    p=${p/D:/\/mnt\/c}
    p=${p/E:/\/mnt\/c}
    p=${p/F:/\/mnt\/c}
  
    # Replace backslashes with forward slashes.
    p=${p//\\/\/}
  
    echo "$p"
  }

  # Convert a path to Windows format (i.e. so it can be passed to a Windows executable).
  function windows_path()
  {
    local p="$1"

    is_wsl || echo "ERROR: windows_path called on $(uname)"
 
    # Change /mnt/c/ to /
    if [[ "$p" == "/mnt/"* ]]; then
      p=${p/\/mnt\/?/}
    else
      # In case ~ is not expanded:
      # shellcheck disable=SC2088
      if [[ "$p" == "~/"* ]]; then
        p="$HOME${p/~/}"
      fi

      # Relative paths work as-is, because the windows process starts up with the Linux current directory.
      # Is this an absolute path?
      if [[ "$p" == "/"* ]]; then
        local ubuntu_version
        ubuntu_version=$(lsb_release -a | grep Release: | awk2)
        p="//wsl\$/Ubuntu-$ubuntu_version$p"
      fi
    fi

    echo "$p"
  }
fi

meldhead() {
  local lines=$1 f1="$2" f2="$3"
  head -n "$lines" "$f1" > "/tmp/$(basename "$f1")-head"
  head -n "$lines" "$f2" > "/tmp/$(basename "$f2")-head"
  meld "/tmp/$(basename "$f1")-head" "/tmp/$(basename "$f2")-head"
}

# URL-encode the arguments
urlencode() {
  echo_no_newline "$@"| jq -sRr '@uri'
}

# Sound a bell (useful when running a long command and you want to know when it's finished).
bell() {
  local count=$1
  [[ -z $count ]] && count=1

  local i
  # shellcheck disable=SC2034
  for i in $(seq 1 "$count"); do
    echo -en '\a'
  done
}

# Sort the input by line length (longest last).
sort-by-line-length() {
  awk '{ print length, $0 }' | sort -n -s | cut -d" " -f2-
}

# Creates a new script and makes it executable.
new-script() {
  local name="$1"
  if [[ -z "$name" ]]; then
    log_error "No script name given"
    return 1
  fi
  if [[ -e "$name" ]]; then
    log_error "Script '$name' already exists"
    return 1
  fi

  cp "$STARTUP_DIR/newscript-template" "$name"
  chmod +x "$name"
  # + option means go to last line
  vi + "$name"
}

if is_installed yq; then
  # Combined two yaml files, e.g.
  # merge_yaml clients.yaml clients-prod.yaml
  merge_yaml() {
    local default="$1" override="$2"

    yq ". *= load(\"$override\")" "$default"
  }
fi

# Adding this to catch whatever the hell is truncating my history file...
check_histfile() {
  if (($(wc -l < "$HISTFILE") < 5000)); then
    log_error "HISTFILE has been truncated!"
  fi
}

git-delete-stale-branches() {
  local branch branches
  git fetch -p
  branches=$(git branch -vv | awk '/^[^*].*: gone]/{print $1}')

  if [[ -z $branches ]]; then
    log "${GREEN}No stale branches."
    return 0
  fi

  log_heading "Stale branches:"
  for branch in $branches; do
    # shellcheck disable=SC2154
    log "$red$branch"
  done

  if prompt "Ready to delete the above branches? "; then
    for branch in $branches; do
      git branch -D "$branch"
    done
  fi
}

# Switch to main branch and pull. Useful after merging a PR.
gmain() {
  local default_branch is_clean=false
  default_branch=$(git remote show origin | sed -n '/HEAD branch/s/.*: //p') || return 1

  # shellcheck disable=SC2143
  [[ -z "$(git status --short --porcelain | grep -v '^\?\?')" ]] && is_clean=true

  $is_clean || git stash         || return 1
  git checkout "$default_branch" || return 1
  gpull                          || return 1
  $is_clean || git stash pop     || return 1
  git-delete-stale-branches
}