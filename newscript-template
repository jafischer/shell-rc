#!/bin/bash

main() {
  set_globals
  parse_options "$@"
}

set_globals() {
  SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

  RED='\x1b[1;31m'
  YELLOW='\x1b[1;33m'
  CYAN='\x1b[1;36m'
  NC='\x1b[0m' # No Color
}

parse_options() {
  while [[ -n ${1} ]]; do
    case ${1} in
    help | --help)
      usage
      ;;
    *)
      usage
      ;;
    esac

    # shellcheck disable=SC2317
    shift
  done
}

usage() {
  log_heading "$(basename "$0")"
  log "INSERT SCRIPT DESCRIPTION HERE"
  log ""
  log "Usage:"
  log "${YELLOW}$(basename "$0")"
#  log "\nOptions:"
#  log "${YELLOW}-x, --xxxxx ARG${CYAN}  -- xxxx."
  log ""

  exit
}

install_if_necessary() {
  echo
  #brew_install command-name "description of command"
}

brew_install() {
  local package="$1" description="$2" ignore

  if ! command -v "$package" >& /dev/null; then
    if ! command -v brew >& /dev/null; then
      log_heading "Installing brew (a utility for installing command line packages)."
      read -p "Press enter when ready, Ctrl-C to quit: " ignore
      do_or_die /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi

    log_heading "Installing $package ($description)."
    read -p "Press enter when ready, Ctrl-C to quit: " ignore
    brew update
    do_or_die brew install "$package"
  fi
}

is_mac() {
  [[ $(uname) == "Darwin" ]]
}

is_linux() {
  [[ $(uname) == "Linux" ]]
}

is_wsl() {
  is_linux && [[ -d /mnt/c ]]
}

log() {
  echo -e "${CYAN}$*$NC" 1>&2
}

log_stdout() {
  echo -e "${LC_INFO}$*$NC"
}

log_heading() {
  local heading="$1" extra="$2" ruler
  # Strip ansi color codes out of the message when creating the ruler
  ruler=$(echo -n "$heading" | sed -e 's/\\x1b\[[0-9;]*m//g' | sed -e 's/./=/g')

  echo -e "${CYAN}+=${ruler}=+$NC" 1>&2
  echo -e "${CYAN}| $heading |    $extra$NC" 1>&2
  echo -e "${CYAN}+=${ruler}=+$NC" 1>&2
}

log_error() {
  echo -e "${RED}$*$NC" 1>&2
}

log_no_newline() {
  echo -en "${CYAN}$*$NC" 1>&2
}

die() {
  log_error "ERROR: $*"
  exit 1
}

do_or_die() {
  "$@" || die "Command failed: '$*'"
}

############
main "$@"
