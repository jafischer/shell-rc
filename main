#!/bin/bash
# Note: the hash-bang above was only added so that my IDE treats this as a shell script. But this script must be
# sourced, not executed from the command line.

[[ $SHELL == /bin/bash ]] && STARTUP_DIR="$(dirname ${BASH_SOURCE[0]})"
[[ $SHELL == /bin/zsh ]] && STARTUP_DIR="${0:a:h}"

# Define a bunch of functions for organization & readability, then call "rc_main" at the end to kick it all off.
rc_main() {
  # Must call `osfuncs` first is_mac/is_wsl are used all over the place.
  source "$STARTUP_DIR/osfuncs"

  rc_set_variables
  rc_set_path
  rc_aliases_and_functions
  rc_shell_settings
  rc_color_variables
  rc_setup_history
  rc_setup_prompt
  rc_finish_up
}

### PERSONALIZE THIS
rc_set_variables() {
  #-------------------------------------------------------------
  # Set some environment variables (the ones with "export") and
  # some variables used in my aliases and functions.
  #-------------------------------------------------------------
  # Set SRC_DIR to the location of your git repos.
  SRC_DIR=~/src
  is_wsl && SRC_DIR=/mnt/c/Users/jafischer.SIE/src
  MYSRC_DIR=~/mysrc
  is_wsl && MYSRC_DIR=/mnt/c/Users/jafischer.SIE/mysrc
  SIE_DIR=~/sie
  is_wsl && SIE_DIR=/mnt/c/Users/jafischer.SIE/sie
  _3RDPARTY_DIR=~/3rdparty
  is_wsl && _3RDPARTY_DIR=/mnt/c/Users/jafischer.SIE/3rdparty

  # If you don't have iCloud storage, ignore this
  if [[ -d "$HOME/Library/Mobile Documents/com~apple~CloudDocs" ]]; then
    if ! [[ -e $HOME/iCloudDrive ]]; then
      ln -s "$HOME/Library/Mobile Documents/com~apple~CloudDocs" $HOME/iCloudDrive
    fi
  fi
  ICLOUD_DIR=$HOME/iCloudDrive
  is_wsl && ICLOUD_DIR=/mnt/c/Users/jafischer.SIE/iCloudDrive

  # When you download and install the "Corretto" version of java, it installs into
  # /Library/Java/JavaVirtualMachines/amazon-corretto-NN.jdk, so I make a symlink
  # called "current" to whatever version of the JDK I'm using
  # (see the "jdk" function in ./functions).
  [[ -d /Library/Java/JavaVirtualMachines/current/Contents/Home ]] &&
    export JAVA_HOME=/Library/Java/JavaVirtualMachines/current/Contents/Home

  # Vi forever!
  export EDITOR=vim
  export EXINIT="source $HOME/.vimrc"

  [[ -d ~/go/go1.21.5 ]] && export GOROOT=~/go/go1.21.5
}

### PERSONALIZE THIS
rc_set_path() {
  local my_path

  # Because this file might get sourced repeatedly (when I'm tweaking it and re-sourcing it),
  # we don't want to keep appending PATH to itself over and over.
  # So the first time this file is sourced, we'll store the path in $ORIG_PATH.
  if [[ -z $ORIG_PATH ]]; then
    #echo "Original path is: $PATH"
    ORIG_PATH="$PATH"
  else
    export PATH="$ORIG_PATH"
  fi

  # Add components to path one at a time, just for readability.

  if is_mac; then
    # I have both ~/bin for scripts, and ~/bin/binaries for binary executables; this is
    # because I'll often grep for something in ~/bin/* and grep can be really slow when searching
    # large binary files...
    my_path="$HOME/bin/binaries"
    my_path="$my_path:$HOME/bin"
    my_path="$my_path:/usr/local/mysql/bin"
    my_path="$my_path:/Library/Java/JavaVirtualMachines/current/Contents/Home/bin"
    my_path="$my_path:/usr/local/MacGPG2/bin"
    my_path="$my_path:/Library/Apple/usr/bin"
    my_path="$my_path:$HOME/go/go1.21.5/bin"
    my_path="$my_path:$HOME/go/bin"
    my_path="$my_path:/Users/jafischer/Library/Application Support/JetBrains/Toolbox/scripts"
  elif is_wsl; then
    my_path="$my_path:/home/linuxbrew/.linuxbrew/bin"
    my_path="$my_path:/opt/apache-maven-3.6.3/bin"
  fi

  my_path="$my_path:$HOME/src/safety-scripts"
  my_path="$my_path:$HOME/src/garbo-cpp/cmake-build-release"
  # Many of my repos have a scripts directory, and I'm tired of typing "./scripts/xxx"
  my_path="$my_path:./scripts"

  # Combine the paths above with ":" as separator:
  if is_wsl; then
    # On WSL I want $HOME/bin/binaries:$HOME/bin at the front of the path.
    export PATH="$HOME/bin/binaries:$HOME/bin:$ORIG_PATH:$my_path"
  else
    export PATH="$ORIG_PATH:$my_path"
  fi

  # Paths for the cd command to search.
  export CDPATH="$SRC_DIR:$MYSRC_DIR:$SIE_DIR:$HOME:$_3RDPARTY_DIR:$HOME/OneDrive/Documents:$ICLOUD_DIR/Documents"
}

rc_aliases_and_functions() {
  #-------------------------------------------------------------
  # Aliases and functions
  #-------------------------------------------------------------
  source "$STARTUP_DIR/aliases"
  source "$STARTUP_DIR/functions"
  is_bash && source "$STARTUP_DIR/completion"
}

rc_shell_settings() {
  #-------------------------------------------------------------
  # Some settings
  #-------------------------------------------------------------

  # See https://ioflood.com/blog/set-linux-command/ for list of "set" options.

  # Report the status of terminated background jobs immediately, rather than before the next primary prompt
  set -o notify

  if is_zsh; then
    # Unlike bash, zsh's for command will treat a variable containing multiple words as one word...
    # This changes that behavior:
    setopt SH_WORD_SPLIT
    # By default, zsh doesn't treat # as a comment in interactive mode; but that's a pain if you're pasting
    # a multi-line command that happens to contain comments.
    setopt INTERACTIVE_COMMENTS

    # I hate the default zsh behavior of printing an error if a wildcard has no match. But maybe that's just because
    # I'm used to decades of sh/bash behavior.
    unsetopt nomatch

    # Case-insensitive tab completion for the win:
    zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
    autoload -Uz compinit && compinit
    # When I hit tab and there are multiple matches, just show me the matches
    # TODO: this doesn't work
    #setopt no_auto_menu
    #setopt bash_auto_list
    # If I accidentally hit tab on an empty command line, don't show me all available commands.
    # TODO: shopt -s no_empty_cmd_completion
    # Case-insensitive wildcards
    unsetopt CASE_GLOB

  elif is_bash; then
    # Case-insensitive tab completion for the win:
    bind "set completion-ignore-case on"
    # This is so useful to me. Just hit tab once and it'll show you all the choices. Don't have to hit double-tab.
    bind "set show-all-if-ambiguous on"

    # Minor errors in directory names will be corrected.
    shopt -s cdspell
    # Update the values of LINES and COLUMNS if window size is changed.
    shopt -s checkwinsize
    # If you accidentally hit tab on an empty command line, it won't show you all available commands.
    shopt -s no_empty_cmd_completion
    # Necessary for programmable completion.
    shopt -s extglob
    # Case-insensitive wildcards
    shopt -s nocaseglob
  else
    log_error "Unsupported shell: $SHELL"
  fi
}

rc_color_variables() {
  #-------------------------------------------------------------
  # Define some variables containing ANSI escape sequences
  # that we can use with "echo -e" to get colorful output.
  # E.g. echo -e "Hello, ${GREEN}world${NC}"
  #-------------------------------------------------------------
  black='\x1b[0;30m'; red='\x1b[0;31m'; green='\x1b[0;32m'; yellow='\x1b[0;33m'; blue='\x1b[0;34m'; pink='\x1b[0;35m'; cyan='\x1b[0;36m'; grey='\x1b[0;37m';
  BLACK='\x1b[1;30m'; RED='\x1b[1;31m'; GREEN='\x1b[1;32m'; YELLOW='\x1b[1;33m'; BLUE='\x1b[1;34m'; PINK='\x1b[1;35m'; CYAN='\x1b[1;36m'; WHITE='\x1b[1;37m'
  NC='\x1b[0m' # No Color
}

rc_setup_history(){
  #-------------------------------------------------------------
  # History config
  #-------------------------------------------------------------


  ### PERSONALIZE THIS
  # I like to keep my history in a git repository because I've had too many instances where somehow my
  # entire bash history file gets cleared, and I search my history a lot.
  # Note: if you do so, make sure you set the repo to private, because your history may contain passwords or other
  # secrets.
  # In fact I wrote a tool to scrub my history before committing it: https://github.com/jafischer/history-shrinker
  export HISTFILE="$HOME/mysrc/shell-history/history-$(my_os)"

  if is_bash; then
    # cmdhist: Save all lines of a multiple-line command in the same history entry.  This allows easy re-editing of multi-line commands.
    # histappend: History is appended to history file, not overwritten.
    # histreedit: user is given the opportunity to re-edit a failed history substitution
    # histverify: the results of history substitution are not immediately executed; user must press enter.
    shopt -s cmdhist histappend histreedit histverify

    HISTTIMEFORMAT="%F %T "
    # ignorespace: preceding a command with a space will omit it from the history.
    # ignoredups: causes lines which match the previous history entry to not be saved
    HISTCONTROL=ignorespace:ignoredups
    HISTSIZE=50000
    HISTFILESIZE=50000
    # "history -a" causes all commands to be immediately appended to .bash_history, instead of only when the shell exits.
    # (useful for when using multiple terminal windows).
    if [[ -z "$PROMPT_COMMAND" ]] ; then
      PROMPT_COMMAND="history -a"
    elif [[ "$PROMPT_COMMAND" != *"history -a"* ]]; then
      PROMPT_COMMAND="${PROMPT_COMMAND}; history -a"
    fi

  elif is_zsh; then
    export HISTFILE="$HOME/mysrc/shell-history/history-zsh-$(my_os)"
    setopt HIST_APPEND HIST_VERIFY HIST_IGNORE_DUPS HIST_IGNORE_SPACE EXTENDED_HISTORY HIST_REDUCE_BLANKS
    HISTSIZE=50000
    SAVEHIST=50000
  else
    log_error "Unsupported shell: $SHELL"
  fi
}

rc_setup_prompt() {
  #-------------------------------------------------------------
  # Set up a fancy prompt to impress the ladies
  #-------------------------------------------------------------

  is_bash && rc_setup_bash_prompt
  is_zsh && rc_setup_zsh_prompt
}

rc_setup_bash_prompt() {
  # The bash shell lets you customize your command prompt via the PS1 variable. You can just set it to a string,
  # like "Hello!" but the real power comes with various special escape sequences.
  # Note: by convention, PS1 tends to end with \$, which will be "$" if you're running normally,
  # but "#" if you're running as root.

  # Complete list of PS1 escapes: see
  # https://tldp.org/HOWTO/Bash-Prompt-HOWTO/bash-prompt-escape-sequences.html

  # Oddly, on MacOS, "echo -e" doesn't accept \e. It requires \x1b instead.
  # BUT... the PS1 prompt understands \e, and not \x1b...
  # So in other words I can't use the color variables I've defined.
  PS1_dir='[\e[1;33mdir: \e[1;36m\w\e[0m] '
  if [[ "$TERM_PROGRAM" == "Apple_Terminal" || is_wsl ]]; then
    ps1_branch() {
      # Built-in BSD date doesn't do nanoseconds, so I installed gdate.
      local t1=$(gdate +%s%N)
      echo -n "$(git status 2>&1 | sed -e "s|fatal:.*|On branch: N/A|" | grep "On branch" | cut -f 3 -d' ')"
      local t2=$(gdate +%s%N)
      [[ -n $DEBUG ]] && echo " ($(((t2 - t1) / 1000000))ms)"
    }
    ps1_ns() {
      # Built-in BSD date doesn't do nanoseconds, so I installed gdate.
      local t1=$(gdate +%s%N)
      echo -n "$(kubectl config view --minify -o jsonpath="{..namespace}")"
      local t2=$(gdate +%s%N)
      [[ -n $DEBUG ]] && echo " ($(((t2 - t1) / 1000000))ms)"
    }
    # shellcheck disable=SC2016
    PS1_branch='[\e[1;33mgit branch: \e[1;36m$(git status 2>&1 | sed -e "s|fatal:.*|On branch: N/A|" | grep "On branch" | cut -f 3 -d" ")\e[0m] '
    # shellcheck disable=SC2016
    PS1_ns='[\e[1;33mk8s ns: \e[1;36m$(kubectl config view --minify -o jsonpath="{..namespace}")\e[0m]'
    # On the mac, `brew install coreutils` to get gdate
    if is_installed gdate; then
      # shellcheck disable=SC2016
      PS1_timestamp='$(gdate +%H:%M:%S.%3N)'
    else
      # shellcheck disable=SC2016
      PS1_timestamp='$(date +%H:%M:%S)'
    fi
  fi
  # TODO: only add these if the time they take is < 250ms?
  # For now, omit branch and namespace on WSL because they're just too slow.
  if is_wsl; then
    PS1=$PS1_dir$PS1_branch'\n'$PS1_timestamp' \$ '
  else
    PS1=$PS1_dir$PS1_branch$PS1_ns'\n'$PS1_timestamp' \$ '
  fi
}

rc_setup_zsh_prompt() {
  # See https://zsh.sourceforge.io/Doc/Release/Prompt-Expansion.html#Prompt-Expansion

  # Enable the running of commands in PS1
  setopt PROMPT_SUBST

  # #~ : current directory, with ~ prefix if under $HOME.
  # Note: %F{11} is bright yellow; I couldn't find a mnemonic that worked (e.g. %F{yellow,bold})
  # See https://robotmoon.com/zsh-prompt-generator/
  PS1_dir='%F{11}dir: %F{cyan}%~%f '

  # shellcheck disable=SC2078
  if [[ "$TERM_PROGRAM" == "Apple_Terminal" || is_wsl ]]; then
    ps1_branch() {
      echo_no_newline "$(git status 2>&1 | sed -e "s|fatal:.*|On branch: N/A|" | grep "On branch" | cut -f 3 -d' ')"
    }
    ps1_ns() {
      echo_no_newline "$(kubectl config view --minify -o jsonpath="{..namespace}")"
    }
    # shellcheck disable=SC2016
    PS1_branch='%F{11}git branch: %F{cyan}$(git status 2>&1 | sed -e "s|fatal:.*|On branch: N/A|" | grep "On branch" | cut -f 3 -d" ")%f '
    # shellcheck disable=SC2016
    PS1_ns='%F{11}k8s ns: %F{cyan}$(kubectl config view --minify -o jsonpath="{..namespace}")%f'
    # On the mac, `brew install coreutils` to get gdate
    if is_installed gdate; then
      # shellcheck disable=SC2016
      PS1_timestamp='$(gdate +%H:%M:%S.%3N)'
    else
      # shellcheck disable=SC2016
      PS1_timestamp='$(date +%H:%M:%S)'
    fi
  fi
  # For now, omit branch and namespace on WSL because they're just too slow.
  if is_wsl; then
    export PS1=$PS1_dir$'\n'$PS1_timestamp' \$ '
  else
    export PS1=$PS1_dir$PS1_branch$PS1_ns$'\n'$PS1_timestamp' \$ '
  fi
}

### PERSONALIZE THIS
rc_finish_up() {
  #-------------------------------------------------------------
  # Miscellaneous
  #-------------------------------------------------------------

  # Just in case I ever forget after adding a new file under .ssh or .secrets.
  # All files in those directories should be only readable by me.
  chmod -R og-rwx ~/.ssh
  [[ -d ~/.secrets ]] && chmod -R og-rwx ~/.secrets

  # Many tools will add something like the following commands to the end of your .bash_profile file.
  # Move them here.

  # shellcheck disable=SC1090
  source ~/.cargo/env
  # Gimme-aws-creds: credentials for AWS (https://github.sie.sony.com/SIE/gimme-aws-creds)
  # shellcheck disable=SC1090
  source ~/.gimme-aws-creds-xaws

  [ -e /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
  [ -e "$HOME/.nvm" ] && {
    export NVM_DIR="$HOME/.nvm"
    . "$NVM_DIR/nvm.sh"  # This loads nvm
    . "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
  }

  # Convert ~ to $HOME in PATH. Do this at the end to account for paths added by any sourced scripts above.
  export PATH="${PATH//\~/$HOME}"
}

##########################

rc_main
