# This script must be "sourced", not executed from the command line. My .bash_profile in my home directory
# consists of one line:
# source $HOME/mysrc/shell-rc/main

# Bash and zsh have totally different ways of getting the path of the current script, so I need to do this
# outside of the main function:
if [[ -n "${BASH_SOURCE[0]}" ]];then
  STARTUP_DIR="$(dirname "${BASH_SOURCE[0]}")"
else
  STARTUP_DIR="${0:a:h}"
fi

# I find that bash scripts become far less intimidating if they're written like normal code...
# So I define a main function, and separate all functionality into various functions that are called by main.
rc_main() {
  # Must call `osfuncs` first, since is_mac/is_wsl are used all over the place.
  source "$STARTUP_DIR/osfuncs"

  rc_color_variables

  if [[ -e "$STARTUP_DIR/.personalized" ]]; then
    source "$STARTUP_DIR/.personalized"
  else
    echo -e "${RED}You haven't created $STARTUP_DIR/.personalized"
    echo -e "${RED}Sourcing the default $STARTUP_DIR/personalized instead${NC}"
    source "$STARTUP_DIR/personalized"
  fi

  rc_set_variables
  rc_set_path
  rc_aliases_and_functions
  rc_shell_settings
  rc_setup_history
  rc_setup_prompt
  rc_finish_up
}

rc_set_variables() {
  # Vi forever!
  export EDITOR=vim
  export EXINIT="source $HOME/.vimrc"

  personalized_set_variables
}

rc_set_path() {
  # Because this file might get sourced repeatedly (when I'm tweaking it and re-sourcing it),
  # we don't want to keep appending PATH to itself over and over.
  # So the first time this file is sourced, we'll store the path in $ORIG_PATH.
  if [[ -z $ORIG_PATH ]]; then
    #echo "Original path is: $PATH"
    ORIG_PATH="$PATH"
  else
    export PATH="$ORIG_PATH"
  fi

  personalized_set_path
}

rc_add_path() {
  local dir_to_add="$1"
  if [[ -d "$dir_to_add" ]]; then
    echo ":$dir_to_add"
  else
    log_error "Path dir $dir_to_add doesn't exist"
  fi
}

rc_aliases_and_functions() {
  #-------------------------------------------------------------
  # Aliases and functions
  #-------------------------------------------------------------
  source "$STARTUP_DIR/aliases"
  source "$STARTUP_DIR/functions"
}

rc_shell_settings() {
  #-------------------------------------------------------------
  # Some settings
  #-------------------------------------------------------------

  # See https://ioflood.com/blog/set-linux-command/ for list of "set" options.

  # Report the status of terminated background jobs immediately, rather than before the next primary prompt
  set -o notify

  if is_zsh; then
    # Unlike bash, zsh's for command will treat a variable containing multiple words as one word...
    # This changes that behavior:
    setopt SH_WORD_SPLIT
    # By default, zsh doesn't treat # as a comment in interactive mode; but that's a pain if you're pasting
    # a multi-line command that happens to contain comments.
    setopt INTERACTIVE_COMMENTS

    # I hate the default zsh behavior of printing an error if a wildcard has no match. But maybe that's just because
    # I'm used to decades of sh/bash behavior.
    unsetopt nomatch

    # Case-insensitive tab completion for the win:
    zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
    autoload -Uz compinit && compinit
    # When I hit tab and there are multiple matches, just show me the matches
    # TODO: this doesn't work
    #setopt no_auto_menu
    #setopt bash_auto_list
    # If I accidentally hit tab on an empty command line, don't show me all available commands.
    # TODO: shopt -s no_empty_cmd_completion
    # Case-insensitive wildcards
    unsetopt CASE_GLOB

  elif is_bash; then
    # Bash version 4+ supports recursive wildcards, e.g. **/*.txt
    [[ $BASH_VERSION == 3* ]] || shopt -s globstar

    # Case-insensitive tab completion for the win:
    bind "set completion-ignore-case on"
    # This is so useful to me. Just hit tab once and it'll show you all the choices. Don't have to hit double-tab.
    bind "set show-all-if-ambiguous on"

    # Minor errors in directory names will be corrected.
    shopt -s cdspell
    # Update the values of LINES and COLUMNS if window size is changed.
    shopt -s checkwinsize
    # If you accidentally hit tab on an empty command line, it won't show you all available commands.
    shopt -s no_empty_cmd_completion
    # Necessary for programmable completion.
    shopt -s extglob
    # Case-insensitive wildcards
    shopt -s nocaseglob
  else
    log_error "Unsupported shell: $SHELL"
  fi
}

rc_color_variables() {
  #-------------------------------------------------------------
  # Define some variables containing ANSI escape sequences
  # that we can use with "echo -e" to get colorful output.
  # E.g. echo -e "Hello, ${GREEN}world${NC}"
  #-------------------------------------------------------------
  black='\x1b[0;30m'; red='\x1b[0;31m'; green='\x1b[0;32m'; yellow='\x1b[0;33m'; blue='\x1b[0;34m'; pink='\x1b[0;35m'; cyan='\x1b[0;36m'; grey='\x1b[0;37m';
  BLACK='\x1b[1;30m'; RED='\x1b[1;31m'; GREEN='\x1b[1;32m'; YELLOW='\x1b[1;33m'; BLUE='\x1b[1;34m'; PINK='\x1b[1;35m'; CYAN='\x1b[1;36m'; WHITE='\x1b[1;37m'
  NC='\x1b[0m' # No Color

  # Add dummy references to each color variable to avoid having to add "shellcheck disable=SC2034" comments on the unused ones.
  echo "$black $red $green $yellow $blue $pink $cyan $grey $BLACK $RED $GREEN $YELLOW $BLUE $PINK $CYAN $WHITE $NC $CURSOR_UP $CLEAR_LINE" > /dev/null
}

rc_setup_history(){
  #-------------------------------------------------------------
  # History config
  #-------------------------------------------------------------

  if is_bash; then
    # cmdhist: Save all lines of a multiple-line command in the same history entry.  This allows easy re-editing of multi-line commands.
    # histappend: history is appended to history file, not overwritten.
    # histreedit: user is given the opportunity to re-edit a failed history substitution
    # histverify: the results of history substitution are not immediately executed; user must press enter.
    shopt -s cmdhist histappend histreedit histverify

    HISTTIMEFORMAT="%F %T "
    # ignorespace: preceding a command with a space will omit it from the history.
    # ignoredups: causes lines which match the previous history entry to not be saved
    HISTCONTROL=ignorespace:ignoredups
    HISTSIZE=50000
    HISTFILESIZE=50000
    # "history -a" causes all commands to be immediately appended to .bash_history, instead of only when the shell exits.
    # (useful for when using multiple terminal tabs/windows).
    if [[ -z "$PROMPT_COMMAND" ]] ; then
      PROMPT_COMMAND="history -a; check_histfile"
    elif [[ "$PROMPT_COMMAND" != *"history -a"* ]]; then
      PROMPT_COMMAND="${PROMPT_COMMAND}; history -a; check_histfile"
    fi

  elif is_zsh; then
    setopt HIST_APPEND HIST_VERIFY HIST_IGNORE_DUPS HIST_IGNORE_SPACE EXTENDED_HISTORY HIST_REDUCE_BLANKS
    HISTSIZE=50000
    # shellcheck disable=SC2034
    SAVEHIST=50000
  else
    log_error "Unsupported shell: $SHELL"
  fi
}

rc_setup_prompt() {
  #-------------------------------------------------------------
  # Set up a fancy prompt to impress the ladies...
  #-------------------------------------------------------------
  # The prompt will look like this (with colors):
  #
  # [dir: ~/mysrc/shell-rc] [git branch: main] [k8s ns: some-namespace]
  # 10:28:31.787 $

  # Complete list of PS1 escapes: see
  # https://tldp.org/HOWTO/Bash-Prompt-HOWTO/bash-prompt-escape-sequences.html
  # Or for zsh:
  # https://zsh.sourceforge.io/Doc/Release/Prompt-Expansion.html#Prompt-Expansion

  if [[ "$TERM_PROGRAM" == "Apple_Terminal" ]] || is_wsl; then
    ps1_branch() {
      git branch --show-current 2>&1 | sed -e "s|fatal:.*|N/A|"
    }
    ps1_ns() {
      kubectl config view --minify -o jsonpath="{..namespace}"
    }

    PS1_dir="$(rc_fix_prompt_codes '[@YELLOWdir: @CYAN@DIR@CLEAR] ')"
    # shellcheck disable=SC2016
    PS1_branch="$(rc_fix_prompt_codes '[@YELLOWgit branch: @CYAN$(ps1_branch)@CLEAR] ')"
    # shellcheck disable=SC2016
    PS1_ns="$(rc_fix_prompt_codes '[@YELLOWk8s ns: @CYAN$(ps1_ns)@CLEAR]')"
    # On the mac, `brew install coreutils` to get gdate
    if is_installed gdate; then
      # shellcheck disable=SC2016
      PS1_timestamp='$(gdate +%H:%M:%S.%3N)'
    else
      # shellcheck disable=SC2016
      PS1_timestamp='$(date +%H:%M:%S)'
    fi

    # In zsh, you have to enable the running of commands in PS1
    is_zsh && setopt PROMPT_SUBST

    # TODO: only add these if the time they take is < 250ms?
    # For now, omit branch and namespace on WSL because they're just too slow.
    if is_wsl; then
      PS1=$PS1_dir$PS1_branch$'\n'$PS1_timestamp' \$ '
    else
      PS1=$PS1_dir$PS1_branch$PS1_ns$'\n'$PS1_timestamp' \$ '
    fi
  fi
}

rc_fix_prompt_codes() {
  local prompt_yellow prompt_cyan prompt_clear prompt_dir

  # Bash and zsh have completely different ways of defining colors in your prompt; so I will use @YELLOW, @CYAN,
  # and @CLEAR in the definition, and use sed to convert that to the appropriate codes depending on the shell.
  if is_bash; then
    prompt_yellow='\\e[1;33m'
    prompt_cyan='\\e[1;36m'
    prompt_clear='\\e[0m]'
    prompt_dir='\\w'
  else
    prompt_yellow='%F{11}'
    prompt_cyan='%F{cyan}'
    prompt_clear='%f'
    prompt_dir='%~'
  fi

  echo "$@" | sed -e "s/@YELLOW/$prompt_yellow/g; s/@CYAN/$prompt_cyan/g; s/@CLEAR/$prompt_clear/g; s/@DIR/$prompt_dir/"
}

rc_finish_up() {
  #-------------------------------------------------------------
  # Miscellaneous
  #-------------------------------------------------------------

  personalized_finish_up

  # Just in case I ever forget after adding a new file under .ssh:
  # All files in those directories should be only readable by me.
  chmod -R og-rwx ~/.ssh

  # Many tools will add something like the following commands to the end of your .bash_profile file.
  # Move them here.
  # shellcheck disable=SC1090
  [[ -e ~/.cargo/env ]] && source ~/.cargo/env

  local save_path="$PATH"
  # I don't like how brew puts itself at the front of the path, so I'm saving the PATH before, and
  # setting it back after calling this brew script.
  [[ -e /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
  export PATH="$save_path"

  # Convert ~ to $HOME in PATH. Do this at the end to account for paths added by any sourced scripts above.
  export PATH="${PATH//\~/$HOME}"
}

##########################

rc_main
